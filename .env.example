# ============================================================
# AI Video Editor Studio — Environment Variables Template
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to version control.
# ============================================================

# ── Google Gemini API ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Whisper Model Selection ───────────────────────────────────
# Dev (CPU): tiny, small, base
# Production (GPU): medium, large-v3
WHISPER_MODEL_SIZE=small

# ── Execution Device ─────────────────────────────────────────
# Leave as "auto" to let the app detect CUDA automatically.
# Force override: "cpu" or "cuda"
COMPUTE_DEVICE=auto

# ── Storage Paths ─────────────────────────────────────────────
# Absolute paths. Leave blank to use defaults relative to project root.
TEMP_DIR=
OUTPUT_DIR=

# ── App Settings ─────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_TEMP_SIZE_GB=5

